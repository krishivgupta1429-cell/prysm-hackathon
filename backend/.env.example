# ══════════════════════════════════════════════════════════════
# Prysm Backend — Environment Variables
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_NAME=Prysm
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prysm

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AI — Multi-model pipeline ────────────────────────────────
# Claude: vision (frame analysis) + reasoning (scoring) + chat
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Groq: audio transcription (Whisper — fast, multilingual)
GROQ_API_KEY=gsk_your-key-here

# Gemini: deep audio listening + Google Search trends
GEMINI_API_KEY=your-gemini-key-here

# Apify: Instagram scraping for real trend data
APIFY_API_TOKEN=apify_your-token-here

# ── Vision settings ───────────────────────────────────────────
VISION_ENABLED=true
VISION_MAX_FRAMES=80
VISION_FRAME_WIDTH=768
VISION_FRAMES_PER_BATCH=8

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=jwt-secret-change-in-production

# ── Storage ───────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_MEDIA_PATH=/tmp/prysm/media

# ── Optional: AWS S3 (production) ────────────────────────────
# STORAGE_BACKEND=s3
# AWS_BUCKET_NAME=prysm-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Optional: Stripe ─────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ═══ Hackathon build (Meta Global AI Developer Hackathon): names only ═══════════════════════════
# Serve every Claude call with Muse Spark. ANTHROPIC_API_KEY is then not needed and the anthropic package is never imported.
AI_PROVIDER=meta
META_API_KEY=
# Optional relay (docs/meta-relay.md): META_BASE_URL=<tunnel url>/v1 and RELAY_SECRET=<the relay's secret>; then META_API_KEY is not needed on this server.
# Optional Meta-layer tuning (leave the model names unset in production; the default muse-spark-1.3 is used and checked at start-up): META_MODEL (default muse-spark-1.3), META_MODEL_MAP (JSON), META_MAX_IMAGES_PER_REQUEST (48),
# META_REASONING_HEADROOM (global), META_REASONING_EFFORT (minimal | low | medium)
# Model per call group (default muse-spark-1.3 each; Wonder is muse-wonder-1.0): vision = calls with images, scoring = the text-only
# scoring/writing calls, chat = streamed ARIA chat. Headroom and effort can be set per group too (hidden reasoning tokens count
# against max_tokens; scoring defaults to 10000 tokens of headroom, vision and chat to 6000).
# Defaults: Spark 1.3 for every group. Wonder (muse-wonder-1.0) is NOT used for analysis; it stays available for experiments only.
META_VISION_MODEL=muse-spark-1.3
META_SCORING_MODEL=muse-spark-1.3
META_CHAT_MODEL=muse-spark-1.3
META_VISION_HEADROOM=
META_SCORING_HEADROOM=
META_CHAT_HEADROOM=
META_VISION_REASONING_EFFORT=
META_SCORING_REASONING_EFFORT=
META_CHAT_REASONING_EFFORT=
# Style addendum (backend/app/studio/coach_style.md) appended to the scoring prompts. DEFAULT ON with AI_PROVIDER=meta (set 0 to turn it off).
# STEP_REGENERATE (default on): regenerate the steps of any parameter with fewer than 3 steps, a fallback line first, or no ready-to-say line.
COACH_STYLE=
STEP_REGENERATE=
# Debugging: save the exact scoring inputs once per analysis (samples/_local/scoring_inputs) for scripts/rescore.py
DEBUG_SAVE_INPUTS=
# Cost breakdown: the owner may fetch it (local testing only; the founder email may always). Modal GPU rate override (USD per GPU second, an estimate)
STUDIO_EXPOSE_COST=
FOUNDER_EMAIL=
MODAL_USD_PER_GPU_SECOND=
# Existing vendors kept as they are
GROQ_API_KEY=
GEMINI_API_KEY=
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
APIFY_API_TOKEN=
# Modal GPU signal models (run `modal token new`, or provide these two)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Demo shell
STUDIO_UNLIMITED=
DEMO_AUTO_VERIFY=
# "Study any reel" (paste a link). Default OFF: unset or empty = off. 1 = on (needs APIFY_API_TOKEN; also set VITE_STUDIO_ALLOW_LINKS=1 on the website)
STUDIO_ALLOW_LINKS=
# Link analyses one user can start per day (default 20), and seconds to wait for a reel download (default 100)
STUDIO_LINK_DAILY_LIMIT=
STUDIO_LINK_DOWNLOAD_TIMEOUT_S=
AUTO_EDIT_ENABLED=
# Hidden budget safety net. STUDIO_DAILY_SPEND_CAP_USD: real USD spent by all analyses and chat per UTC day before new analyses are
# refused (code default 10; the local test stack sets 25). The cap is enforced from the recorded real cost of each analysis.
STUDIO_DAILY_SPEND_CAP_USD=
STUDIO_USER_MAX_CONCURRENT=
STUDIO_USER_HOURLY_LIMIT=
# Analyses one user can start per UTC day (0 or empty = no limit; REQUIRED, greater than 0, when APP_ENV=production)
STUDIO_USER_DAILY_LIMIT=
STUDIO_REGISTER_PER_IP_HOURLY=
STUDIO_MAX_CONCURRENT=
# Public deployment (Railway): with APP_ENV=production the server refuses to start unless every required variable is set; the full list
# with where to get each value is docs/deploy-checklist.md. Server processes per container (each loads the analysis libraries):
WEB_CONCURRENCY=
# Cloudflare R2 (edited videos from the auto-edit step; required while AUTO_EDIT_ENABLED is on)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Predicted Viewer Behaviour: modal (needs MODAL_TOKEN_ID/SECRET above and the deployed Modal app) or heuristic. Not runpod.
ENGAGEMENT_BACKEND=
# Deployment
FRONTEND_URL=
CORS_ORIGINS=
TRUSTED_HOSTS=
CSP_CONNECT_SRC=
PROMOTE_EMAILS=
# Phase 2 evidence switches (each can be turned off on its own)
EVIDENCE_VOICE_CONSENSUS=
EVIDENCE_SPARK_AUDIO=
EVIDENCE_SUBJECTS=
EVIDENCE_SIGNALS=
EVIDENCE_MUSIC_ID=
EVIDENCE_TRENDS=
# Local only: serve the saved blind bake-off variants to /dev/bakeoff (keep OFF everywhere else)
DEV_BAKEOFF=

# --- Instagram connect + Creator DNA (hackathon) ---
# The HACKATHON Meta app only (never the production app). Instagram API with Instagram Login: use the Instagram app id/secret
# from App Dashboard > Instagram > API setup with Instagram login (not the top-level Meta app id).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must be HTTPS and listed exactly in the dashboard (see docs/instagram-login.md section 4), e.g. https://<tunnel-or-backend-host>/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Where the browser returns after the callback (the website), e.g. http://localhost:5177
INSTAGRAM_FRONTEND_URL=
# Dev only: 12 fake reels instead of Instagram. Refused unless APP_ENV is not production, the frontend is on localhost and the request is local.
INSTAGRAM_FIXTURE=0
# Creator DNA: the cheap Spark model for fingerprints and the DNA summary, and the per-import cost cap in USD
META_DNA_MODEL=muse-spark-1.3
DNA_COST_CAP_USD=0.60
# Personalise analyses with the creator's DNA: unset or 1 = on for users who have one, 0 = off
COACH_PERSONALISE=1

# Hackathon: encrypts the Instagram access token at rest (Fernet). Required in production; generate one with
#   python -m app.studio.instagram.tokencrypt generate
# Several keys may be listed, comma separated (the first encrypts, all decrypt: key rotation). Never commit the real value.
TOKEN_ENCRYPTION_KEY=

# DINOv2 (hackathon, dev only): DEV_DINO=1 mounts /dino/* (needs login). DINO_BACKEND = modal | off (unset: modal when URL and token are set)
DEV_DINO=
DINO_BACKEND=
DINO_MODAL_URL=
DINO_MODAL_TOKEN=
