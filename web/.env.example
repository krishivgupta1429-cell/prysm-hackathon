# Built during the Meta Global AI Developer Hackathon (new work).
# Prysm website: copy to web/.env.local (dev) or set in the host's dashboard. Names only; no values are committed.

VITE_STUDIO_MODE=1
# Local dev only: the API origin. Leave unset on a host that proxies through vercel.json / netlify.toml / _redirects
# (point those at your backend with: web/scripts/set_backend_url.sh https://your-backend.example.com)
VITE_API_URL=
# Direct-to-backend uploads that skip the host's request body limit (usually the same backend URL)
VITE_UPLOAD_URL=
# Show the reel-link option (the original Apify route) in demo mode. Set to 1 together with STUDIO_ALLOW_LINKS=1 on the backend.
VITE_STUDIO_ALLOW_LINKS=
# Dev server only: where /auth, /prysm ... are proxied when VITE_API_URL is unset (default http://localhost:8000)
VITE_PROXY_TARGET=
VITE_PORT=
VITE_SUPPORT_EMAIL=
# Social links appear in the footer / FAQ only when set
VITE_SOCIAL_X=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
# Analytics are off unless these are set
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
VITE_PUBLIC_CLARITY_ID=
# Hackathon: per-analysis cost panel on the results page. 1 = show it (local testing). The backend must also allow it
# (STUDIO_EXPOSE_COST=1 for local, or the logged-in user's email equals FOUNDER_EMAIL / VITE_FOUNDER_EMAIL).
VITE_SHOW_COST_PANEL=
VITE_FOUNDER_EMAIL=
